# The DOI of the archived release. Zenodo's GitHub integration was
# enabled on 2026-11-23 and archived the v2.3.0 release automatically;
# the record is published, not a draft, and is registered with DataCite
# (10.5281/zenodo.24453044, v2.3.0, MIT).
#
# The key was absent before that, deliberately: the repository had no
# Zenodo record of its own, and a placeholder string under `doi:` would
# render in GitHub's "Cite this repository" box as a link to a record
# that does not exist. The same reason applies to `identifiers:` --
# there is no preprint DOI yet, so that entry is not declared either.
doi: "10.5281/zenodo.24453044"
url: "https://github.com/rollroyces/deepcatch"
repository-code: "https://github.com/rollroyces/deepcatch"
repository-companion: "https://github.com/rollroyces/cfdna-fragmentomics-pipeline"
