  "interpretation": {
    "coverage_baseline": "coverage_baseline_n_cpgs_auc is the number of covered CpGs alone; a methylation feature must beat it to mean anything",
    "boundary_estimator": "mean_unmethylated_fraction is the share of a CpG's observations that sit at a fragment end; it estimates the unmethylated state without a model, a prior or training",
    "matched_locus": "the matched-locus tests restrict both arms to the CpGs they share, so a difference there cannot be produced by library composition",
    "decoder_degeneracy": "fraction_intermediate near zero means the decoder returned hard 0/1 calls, so the beta summary is a count of called states rather than a graded methylation level"
  }
