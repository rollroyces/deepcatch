# =============================================================================
# DeepCatch .gitignore
# =============================================================================

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
venv/
env/
.env
.venv
pip-wheel-metadata/
pip-log.txt

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Jupyter Notebooks ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Machine Learning ────────────────────────────────────────────────────────
*.pt
*.pth
*.h5
*.ckpt
*.pb
*.onnx

# ── Data files (large) ──────────────────────────────────────────────────────
*.vcf.gz
*.vcf.gz.tbi
*.bam
*.bam.bai
*.fastq.gz
*.fastq
*.fq.gz
*.fq
*.bed
data/
db/

# ── TCGA downloader caches (regenerable API JSONs/CSVs; keep open-access MAFs) ──
validation/tcga/tcga_cache/*.json
validation/tcga/tcga_cache/*.csv

# ── Results (keep reports, ignore raw dumps) ────────────────────────────────
results/*.json
results/*.png
results/*.csv
results/*.tsv
results/*.h5
!results/README.md
!results/**/README.md

# ── OS files ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
\#*\#
*.tmp
*.bak

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-*
.cursor/

# ── LaTeX intermediate ──────────────────────────────────────────────────────
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.lot
paper/*.lof
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz
paper/*.pdf

# ── Docker ──────────────────────────────────────────────────────────────────
.dockerignore

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Secrets ─────────────────────────────────────────────────────────────────
*.env
*.secret
*.key
credentials.json
token.json

# ── Paper submission materials (archive-only) ────────────────────────────
paper/BIORXIV_RESUBMIT.md
paper/BIORXIV_SUBMISSION.md
paper/MEDRXIV_SUBMISSION.md
paper/CLAIMS_LOG.md
paper/SUBMISSION_CHECKLIST.md
paper/SUBMISSION_GUIDE.md
paper/abstract*.txt
paper/cover_letter*.txt
paper/email_to_biorxiv_support.txt
paper/*.tar.gz

# ── Research notes (not part of codebase) ───────────────────────────────
research/CET_OPTIMIZATION_RESEARCH.md
research/COMPETITIVE_LANDSCAPE.md
research/CUHK_JIANG_LAB_CONTACT.md
research/DBGAP_ACCESS_Cristiano2019.md
research/FRAGMENTOSIGN_VALIDATION_REPORT.md
research/TIER_ANALYSIS.md
research/real_data_report.md

# ─── Review files (internal only) ───────────────────────────────────────
review/*.md

# ─── Result reports (simulation-based, not verified) ────────────────────
results/node/*.md
results/BIOINFORMATICS_VALIDATION_REPORT.md
results/benchmark_table.md
results/literature_review.md
results/py/README.md
results/real_motif_extraction/*.md
results/delfi_1000g_validation/*.md
results/delfi_1000g_validation/*.json
results/delfi_1000g_validation/*.npy
results/delfi_1000g_validation/*.csv
results/delfi_1000g_validation/*.fa
results/delfi_1000g_validation/*.fai
results/delfi_1000g_validation/*.py
results/prof_jiang_4mer_analysis/deepcatch_manifesto.md
*.xlsx
